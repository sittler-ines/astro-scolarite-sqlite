---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Connexion" nav={false}>
  <div class="login card">
    <h1>Connexion</h1>
    {error && <p class="error">La connexion a échoué ({error}). Réessayez.</p>}
    <button id="login-google" class="btn" type="button">Se connecter avec Google</button>
  </div>
</Layout>

<script>
  import { signIn } from 'auth-astro/client';

  document.querySelector('#login-google')?.addEventListener('click', () => signIn('google'));
</script>
